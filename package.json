{
  "name": "dsh-session-quickbar",
  "version": "0.2.0",
  "description": "A configurable quick-action strip on the right of every sidebar Session row, with a two-way channel to the Sessions that author plugins.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CONTRACT.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quickbar",
    "sidebar",
    "session",
    "actions",
    "channel"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "license": "MIT",
  "author": "879745uhjun",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/879745uhjun/dsh-session-quickbar.git"
  },
  "homepage": "https://github.com/879745uhjun/dsh-session-quickbar#readme",
  "bugs": {
    "url": "https://github.com/879745uhjun/dsh-session-quickbar/issues"
  }
}
